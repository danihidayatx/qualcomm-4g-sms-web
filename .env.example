# Qualcomm 4G Modem SMS Configuration
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# HTTP Server Port and Binding
PORT=8080
BIND_HOST=127.0.0.1

# Optional API Token for external automation scripts, curl, and bots
# If configured, external requests can access /api/sms using:
#   1. Query parameter:  http://127.0.0.1:8080/api/sms?token=<TOKEN>
#   2. HTTP header:      X-API-Token: <TOKEN>
#   3. Bearer header:    Authorization: Bearer <TOKEN>
#
# If left empty, /api/sms can only be accessed via Web UI session login.
SMS_API_TOKEN=
