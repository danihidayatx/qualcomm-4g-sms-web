[Unit]
Description=UFI Modem SMS Reader and Web UI Proxy
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ufi-sms
ExecStart=/usr/bin/node /opt/ufi-sms/ufi-sms-web.js
Restart=always
RestartSec=5
Environment=PORT=8080
Environment=BIND_HOST=127.0.0.1

[Install]
WantedBy=multi-user.target
